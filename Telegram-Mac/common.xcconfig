SIMPLE_SLASH=/

GERGRAM_BUNDLE_ID = org.gergram.macos
GERGRAM_TEAM_ID =
GERGRAM_API_ID =
GERGRAM_API_HASH =
GERGRAM_CRASH_REPORT_BOT =
GERGRAM_APP_GROUP = $(GERGRAM_TEAM_ID).$(GERGRAM_BUNDLE_ID)
GERGRAM_SHARE_GROUP = $(GERGRAM_APP_GROUP).TelegramShare
SFEED_URL =
DSA_PEM_FILE =

#include? "../Local.xcconfig"

WEBRTC_MAC = 1
GCC_PREPROCESSOR_DEFINITIONS = $(inherited) WEBRTC_MAC=$(WEBRTC_MAC)
