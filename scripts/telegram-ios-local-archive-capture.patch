@@ -0,0 +1,27 @@
+import Foundation
+
+public struct LocalArchiveCaptureSettings: Codable, Equatable {
+    public static let key = ValueBoxKey("gergram.local-archive.capture")
+    public static let defaultSettings = LocalArchiveCaptureSettings()
+
+    public let captureDeletions: Bool
+    public let captureEdits: Bool
+    public let captureBots: Bool
+
+    public init(captureDeletions: Bool = false, captureEdits: Bool = false, captureBots: Bool = false) {
+        self.captureDeletions = captureDeletions
+        self.captureEdits = captureEdits
+        self.captureBots = captureBots
+    }
+}
+
+public extension Transaction {
+    func localArchiveCaptureSettings() -> LocalArchiveCaptureSettings {
+        return self.getPreferencesEntry(key: LocalArchiveCaptureSettings.key)?.get(LocalArchiveCaptureSettings.self) ?? .defaultSettings
+    }
+
+    func updateLocalArchiveCaptureSettings(_ settings: LocalArchiveCaptureSettings) {
+        guard let entry = PreferencesEntry(settings) else { return }
+        self.updatePreferencesEntry(key: LocalArchiveCaptureSettings.key) { _ in entry }
+    }
+}
