diff --git a/submodules/TelegramCore/Sources/State/Sync/LocalArchiveCapture.swift b/submodules/TelegramCore/Sources/State/Sync/LocalArchiveCapture.swift
new file mode 100644
index 0000000..7eb22fd
--- /dev/null
+++ b/submodules/TelegramCore/Sources/State/Sync/LocalArchiveCapture.swift
@@ -0,0 +1,239 @@
+import Foundation
+import Postbox
+
+public struct LocalArchiveSnapshot {
+    public let text: String
+    public let timestamp: Int32
+    public let authorId: PeerId?
+    public let entities: [MessageTextEntity]
+
+    private static let maximumPayloadSize = 32 * 1024
+    private static let maximumTextSize = 16 * 1024
+    private static let maximumEntityCount = 128
+
+    private struct Payload: Codable {
+        let version: Int
+        let text: String
+        let timestamp: Int32
+        let author: Int64?
+        let entities: [Entity]
+    }
+
+    private struct Entity: Codable {
+        private enum CodingKeys: String, CodingKey {
+            case rawType = "_rawValue"
+            case peerId
+            case stickerPack = "s"
+        }
+
+        let value: MessageTextEntity
+
+        init(_ value: MessageTextEntity) {
+            if case let .CustomEmoji(_, fileId) = value.type {
+                self.value = MessageTextEntity(range: value.range, type: .CustomEmoji(stickerPack: nil, fileId: fileId))
+            } else {
+                self.value = value
+            }
+        }
+
+        init(from decoder: Decoder) throws {
+            let container = try decoder.container(keyedBy: CodingKeys.self)
+            let rawType = try container.decode(Int32.self, forKey: .rawType)
+            switch rawType {
+            case 11:
+                let peerId = try container.decode(Int64.self, forKey: .peerId)
+                guard LocalArchiveSnapshot.decodeCloudPeerId(peerId) != nil else {
+                    throw DecodingError.dataCorruptedError(forKey: .peerId, in: container, debugDescription: "Invalid archived mention peer")
+                }
+            case 18:
+                guard !container.contains(.stickerPack) else {
+                    throw DecodingError.dataCorruptedError(forKey: .stickerPack, in: container, debugDescription: "Unexpected archived sticker pack reference")
+                }
+            default:
+                break
+            }
+            self.value = try MessageTextEntity(from: decoder)
+        }
+
+        func encode(to encoder: Encoder) throws {
+            try self.value.encode(to: encoder)
+        }
+    }
+
+    public static func decode(_ data: Data) -> LocalArchiveSnapshot? {
+        guard data.count <= Self.maximumPayloadSize,
+              let payload = try? JSONDecoder().decode(Payload.self, from: data),
+              payload.version == 1, payload.timestamp > 0 else {
+            return nil
+        }
+        let authorId = payload.author.flatMap(Self.decodeCloudPeerId)
+        let entities = payload.entities.map(\.value)
+        guard payload.author == nil || authorId != nil,
+              Self.isValidText(payload.text, entities: entities) else {
+            return nil
+        }
+        return LocalArchiveSnapshot(text: payload.text, timestamp: payload.timestamp, authorId: authorId, entities: entities)
+    }
+
+    fileprivate static func encode(text: String, timestamp: Int32, authorId: PeerId?, entities: [MessageTextEntity]) -> Data? {
+        guard timestamp > 0, Self.isValidText(text, entities: entities) else { return nil }
+        let payload = Payload(version: 1, text: text, timestamp: timestamp, author: authorId?.toInt64(), entities: entities.map(Entity.init))
+        guard let data = try? JSONEncoder().encode(payload), data.count <= Self.maximumPayloadSize else { return nil }
+        return data
+    }
+
+    private static func decodeCloudPeerId(_ value: Int64) -> PeerId? {
+        let bits = UInt64(bitPattern: value)
+        let namespace = (bits >> 32) & 0x7
+        guard bits >> 59 == 0, namespace <= 2, (bits & ~(UInt64(0x7) << 32)) != 0 else { return nil }
+        return PeerId(value)
+    }
+
+    fileprivate static func isValidText(_ text: String, entities: [MessageTextEntity], allowEmpty: Bool = false) -> Bool {
+        guard allowEmpty || !text.isEmpty,
+              text.utf8.count <= Self.maximumTextSize,
+              entities.count <= Self.maximumEntityCount else {
+            return false
+        }
+        let textLength = text.utf16.count
+        return entities.allSatisfy { entity in
+            guard entity.range.lowerBound >= 0, !entity.range.isEmpty, entity.range.upperBound <= textLength else { return false }
+            switch entity.type {
+            case .Spoiler, .Unknown, .Custom:
+                return false
+            case let .TextMention(peerId):
+                return Self.decodeCloudPeerId(peerId.toInt64()) != nil
+            case let .TextUrl(url):
+                return url.utf8.count <= 2048
+            case let .Pre(language):
+                return (language?.utf8.count ?? 0) <= 128
+            default:
+                return true
+            }
+        }
+    }
+}
+
+extension ReplayContext {
+    func archiveDeletedMessages(_ ids: [MessageId], revision: Int32?) {
+        self.archiveDeletedMessages(in: ids, revision: revision) { Array($0) }
+    }
+
+    func archiveDeletedGlobalMessages(_ ids: [Int32], revision: Int32?) {
+        self.archiveDeletedMessages(in: ids, revision: revision) { self.transaction.messageIdsForGlobalIds(Array($0)) }
+    }
+
+    private func archiveDeletedMessages<ID>(in ids: [ID], revision: Int32?, resolve: (ArraySlice<ID>) -> [MessageId]) {
+        guard let revision, revision > 0, !ids.isEmpty else { return }
+        let settings = self.transaction.localArchiveCaptureSettings()
+        guard settings.captureDeletions else { return }
+        let now = Int64(Date().timeIntervalSince1970)
+        let batchSize = 128
+        for offset in stride(from: 0, to: ids.count, by: batchSize) {
+            let end = min(offset + batchSize, ids.count)
+            var messages: [LocalArchiveMessage] = []
+            for id in resolve(ids[offset ..< end]) {
+                guard let message = self.eligibleArchiveMessage(id, captureBots: settings.captureBots),
+                      let archived = Self.archiveEntry(message, kind: .deletion, revision: revision, now: now) else { continue }
+                messages.append(archived)
+            }
+            self.storeArchiveEntries(messages, now: now)
+        }
+    }
+
+    func archiveEditedMessage(_ id: MessageId, updated: StoreMessage, revision: Int32?) {
+        guard let revision, revision > 0, case let .Id(updatedId) = updated.id, updatedId == id else { return }
+        let settings = self.transaction.localArchiveCaptureSettings()
+        guard settings.captureEdits,
+              updated.flags.contains(.Incoming), !updated.flags.contains(.CopyProtected),
+              updated.authorId != self.accountPeerId, updated.forwardInfo == nil,
+              Self.isArchiveContentAllowed(attributes: updated.attributes, media: updated.media, captureBots: settings.captureBots),
+              !updated.attributes.contains(where: { ($0 as? EditedMessageAttribute)?.isHidden == true }),
+              let previous = self.eligibleArchiveMessage(id, captureBots: settings.captureBots),
+              previous.author?.id == updated.authorId,
+              !previous.attributes.contains(where: { ($0 as? ChannelMessageStateVersionAttribute).map { $0.pts >= revision } == true }) else {
+            return
+        }
+        let previousEntities = previous.textEntitiesAttribute?.entities ?? []
+        let updatedEntities = updated.attributes.lazy.compactMap { $0 as? TextEntitiesMessageAttribute }.first?.entities ?? []
+        guard !previous.text.utf16.elementsEqual(updated.text.utf16) || previousEntities != updatedEntities,
+              LocalArchiveSnapshot.isValidText(updated.text, entities: updatedEntities, allowEmpty: true) else {
+            return
+        }
+        let now = Int64(Date().timeIntervalSince1970)
+        if let archived = Self.archiveEntry(previous, kind: .edit, revision: revision, now: now) {
+            self.storeArchiveEntries([archived], now: now)
+        }
+    }
+
+    private func eligibleArchiveMessage(_ id: MessageId, captureBots: Bool) -> Message? {
+        guard id.namespace == Namespaces.Message.Cloud, id.id > 0,
+              id.peerId != self.accountPeerId, id.peerId.id._internalGetInt64Value() > 0,
+              let message = self.transaction.getMessage(id), !message.text.isEmpty,
+              message.flags.contains(.Incoming), message.forwardInfo == nil,
+              !message.isCopyProtected(), message.threadId.map({ $0 > 0 }) != false,
+              let author = message.author, author.id != self.accountPeerId,
+              Self.isArchivePeerAllowed(author, captureBots: captureBots),
+              let peer = self.transaction.getPeer(id.peerId),
+              Self.isArchivePeerAllowed(peer, captureBots: captureBots),
+              self.finalState.state.peers[id.peerId].map({ Self.isArchivePeerAllowed($0, captureBots: captureBots) }) != false,
+              Self.isArchiveContentAllowed(attributes: message.attributes, media: message.media, captureBots: captureBots) else {
+            return nil
+        }
+        if id.peerId.namespace == Namespaces.Peer.CloudUser {
+            guard let cached = self.transaction.getPeerCachedData(peerId: id.peerId) as? CachedUserData,
+                  cached.flags.intersection([.copyProtectionEnabled, .myCopyProtectionEnabled]).isEmpty else {
+                return nil
+            }
+        }
+        return message
+    }
+
+    private static func isArchivePeerAllowed(_ peer: Peer, captureBots: Bool) -> Bool {
+        guard !peer.isCopyProtectionEnabled else { return false }
+        switch peer {
+        case let user as TelegramUser:
+            return user.restrictionInfo?.rules.isEmpty != false && (captureBots || user.botInfo == nil)
+        case let channel as TelegramChannel:
+            return channel.restrictionInfo?.rules.isEmpty != false
+        case is TelegramGroup:
+            return true
+        default:
+            return false
+        }
+    }
+
+    private static func isArchiveContentAllowed(attributes: [MessageAttribute], media: [Media], captureBots: Bool) -> Bool {
+        guard media.allSatisfy({ $0 is TelegramMediaImage || $0 is TelegramMediaFile || $0 is TelegramMediaWebpage }) else {
+            return false
+        }
+        for attribute in attributes {
+            switch attribute {
+            case is AutoclearTimeoutMessageAttribute, is AutoremoveTimeoutMessageAttribute,
+                 is EphemeralMessageAttribute, is EphemeralOutgoingMessageAttribute, is EphemeralReplacementMessageAttribute,
+                 is RestrictedContentMessageAttribute, is PaidStarsMessageAttribute, is RichTextMessageAttribute,
+                 is MediaSpoilerMessageAttribute, is PendingProcessingMessageAttribute, is ContentRequiresValidationMessageAttribute:
+                return false
+            case is InlineBotMessageAttribute, is InlineBusinessBotMessageAttribute:
+                if !captureBots { return false }
+            default:
+                break
+            }
+        }
+        return true
+    }
+
+    private static func archiveEntry(_ message: Message, kind: LocalArchiveMessage.Kind, revision: Int32, now: Int64) -> LocalArchiveMessage? {
+        let entities = message.textEntitiesAttribute?.entities ?? []
+        guard let snapshot = LocalArchiveSnapshot.encode(text: message.text, timestamp: message.timestamp, authorId: message.author?.id, entities: entities) else {
+            return nil
+        }
+        let id = LocalArchiveMessage.ID(message: message.id, threadId: message.threadId, kind: kind, revision: Int64(revision))
+        return LocalArchiveMessage(id: id, capturedAt: now, snapshot: snapshot)
+    }
+
+    private func storeArchiveEntries(_ entries: [LocalArchiveMessage], now: Int64) {
+        guard !entries.isEmpty else { return }
+        try? self.transaction.appendLocalArchiveMessages(accountId: self.accountPeerId.toInt64(), messages: entries, now: now)
+    }
+}
