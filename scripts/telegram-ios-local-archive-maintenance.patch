diff --git a/submodules/TelegramCore/Sources/Account/LocalArchiveMaintenance.swift b/submodules/TelegramCore/Sources/Account/LocalArchiveMaintenance.swift
new file mode 100644
index 0000000..617e8bb
--- /dev/null
+++ b/submodules/TelegramCore/Sources/Account/LocalArchiveMaintenance.swift
@@ -0,0 +1,46 @@
+#if os(macOS)
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+func closeLocalMessageArchive(postbox: Postbox, accountPeerId: PeerId) -> Signal<Void, NoError> {
+    let accountId = accountPeerId.toInt64()
+    return drainLocalArchiveBatches(postbox: postbox) { transaction in
+        try transaction.closeAndClearLocalArchive(accountId: accountId, limit: 128)
+    }
+}
+
+func managedLocalArchiveRetention(postbox: Postbox, accountPeerId: PeerId) -> Signal<Never, NoError> {
+    let accountId = accountPeerId.toInt64()
+    let prune = deferred {
+        pruneLocalMessageArchive(postbox: postbox, accountId: accountId, now: Int64(Date().timeIntervalSince1970))
+        |> ignoreValues
+    }
+    return (prune |> then(.complete() |> suspendAwareDelay(60.0 * 60.0, granularity: 60.0, queue: .concurrentDefaultQueue())))
+    |> restart
+}
+
+func pruneLocalMessageArchive(postbox: Postbox, accountId: Int64, now: Int64) -> Signal<Void, NoError> {
+    return drainLocalArchiveBatches(postbox: postbox) { transaction in
+        try transaction.pruneLocalArchive(accountId: accountId, now: now)
+    }
+}
+
+private func drainLocalArchiveBatches(postbox: Postbox, batch: @escaping (Transaction) throws -> Bool) -> Signal<Void, NoError> {
+    return postbox.transaction { transaction -> Bool in
+        do {
+            return try batch(transaction)
+        } catch LocalArchiveError.closed {
+            return false
+        } catch {
+            Logger.shared.log("LocalArchive", "Maintenance failed: \(error)")
+            return false
+        }
+    }
+    |> restart
+    |> take(until: { hasMore in
+        SignalTakeAction(passthrough: !hasMore, complete: !hasMore)
+    })
+    |> map { _ in () }
+}
+#endif
