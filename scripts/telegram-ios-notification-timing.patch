new file mode 100644
index 0000000..06b2ffb
--- /dev/null
+++ b/submodules/TelegramCore/Sources/State/NotificationDeliveryTiming.swift
@@ -0,0 +1,16 @@
+import Foundation
+import Postbox
+import SwiftSignalKit
+
+let notificationDeliveryTimingKey = ValueBoxKey("gergram.notification-delivery-timing")
+
+public struct NotificationDeliveryTiming: Codable, Equatable {
+    public let cloudDelayMilliseconds: Int32
+    public let defaultDelayMilliseconds: Int32
+}
+
+public func notificationDeliveryTiming(postbox: Postbox) -> Signal<NotificationDeliveryTiming?, NoError> {
+    return postbox.preferencesView(keys: [notificationDeliveryTimingKey])
+    |> map { $0.values[notificationDeliveryTimingKey]?.get(NotificationDeliveryTiming.self) }
+    |> distinctUntilChanged
+}
