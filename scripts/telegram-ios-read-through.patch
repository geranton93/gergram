+func _internal_applyReadThroughForumTopicInteractively(account: Account, messageId: MessageId, threadId: Int64, groupingKey: Int64?, isEligible: @escaping (Peer, CachedPeerData?, Message) -> Bool) -> Signal<Bool, NoError> {
+    func checkedTarget(_ transaction: Transaction) -> (Api.InputPeer, MessageHistoryThreadData)? {
+        guard let (peer, data) = forumReadThroughTarget(transaction: transaction, accountPeerId: account.peerId,
+                                                       messageId: messageId, threadId: threadId, groupingKey: groupingKey, isEligible: isEligible),
+              let updated = forumReadThroughState(transaction: transaction, accountPeerId: account.peerId,
+                                                  messageId: messageId, threadId: threadId, data: data) else { return nil }
+        return (peer, updated)
+    }
+
+    return account.postbox.transaction(userInteractive: true) { transaction in
+        return checkedTarget(transaction)?.0
+    }
+    |> mapToSignal { inputPeer -> Signal<Bool, NoError> in
+        guard let inputPeer else { return .single(false) }
+        return account.network.request(Api.functions.messages.readDiscussion(peer: inputPeer, msgId: Int32(threadId), readMaxId: messageId.id))
+        |> `catch` { _ -> Signal<Api.Bool, NoError> in
+            return .single(.boolFalse)
+        }
+        |> timeout(30.0, queue: .concurrentDefaultQueue(), alternate: .single(.boolFalse))
+        |> mapToSignal { result -> Signal<Bool, NoError> in
+            guard case .boolTrue = result else { return .single(false) }
+            return account.postbox.transaction(userInteractive: true) { transaction in
+                if let (_, updated) = checkedTarget(transaction), let entry = StoredMessageHistoryThreadInfo(updated) {
+                    transaction.setMessageHistoryThreadInfo(peerId: messageId.peerId, threadId: threadId, info: entry)
+                    transaction.afterCommit {
+                        account.stateManager.notifyAppliedIncomingReadMessages([messageId])
+                    }
+                }
+                return true
+            }
+        }
+    }
+}
