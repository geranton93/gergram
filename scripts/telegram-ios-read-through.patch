+func _internal_applyReadThroughMessageInteractively(account: Account, messageId: MessageId, groupingKey: Int64?, isEligible: @escaping (Peer, CachedPeerData?, Message) -> Bool) -> Signal<Bool, NoError> {
+    return account.postbox.transaction(userInteractive: true) { transaction -> Bool in
+        guard messageId.namespace == Namespaces.Message.Cloud, messageId.id > 0, messageId.id < Int32.max,
+              messageId.peerId != account.peerId,
+              let peer = transaction.getPeer(messageId.peerId), !peer.isDeleted, !peer.isForumOrMonoForum,
+              peerKeepsReadState(peer),
+              let message = transaction.getMessage(messageId), message.groupingKey == groupingKey,
+              message.threadId == nil, message.effectivelyIncoming(account.peerId) else { return false }
+
+        switch peer {
+        case is TelegramUser, is TelegramChannel:
+            break
+        case let group as TelegramGroup where group.membership == .Member && group.migrationReference == nil:
+            break
+        default:
+            return false
+        }
+
+        let cachedData = transaction.getPeerCachedData(peerId: peer.id)
+        if let channel = cachedData as? CachedChannelData, channel.isNotAccessible || channel.migrationReference != nil {
+            return false
+        }
+        guard let readState = transaction.getCombinedPeerReadState(peer.id),
+              let state = readState.states.first(where: { $0.0 == messageId.namespace })?.1,
+              case let .idBased(maxIncomingReadId, _, _, _, _) = state,
+              messageId.id > maxIncomingReadId,
+              !readState.states.contains(where: { $0.0 != messageId.namespace && $0.1.count != 0 }),
+              isEligible(peer, cachedData, message) else { return false }
+
+        if let groupingKey {
+            guard let album = transaction.getMessageGroup(messageId),
+                  album.contains(where: { $0.id == messageId }),
+                  album.allSatisfy({ $0.groupingKey == groupingKey && $0.id.peerId == peer.id && $0.id.namespace == messageId.namespace && $0.id.id <= messageId.id }) else { return false }
+        }
+        transaction.applyInteractiveReadThroughIndex(message.index)
+        account.stateManager.notifyAppliedIncomingReadMessages([messageId])
+        return true
+    }
+}
